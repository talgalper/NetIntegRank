manifest {
  name        = 'NetIntegRank'
  author      = 'Tal Galper'
  description = 'Dysregulated subnetworks → integrated evidence ranking'
  mainScript  = 'main.nf'
  homePage    = 'https://github.com/talgalper/netintegrank'
  version     = '2.0'
}

params {
  outdir = "results"

  // HHNet inputs
  scores       = null
  hhnet_run_id = null

  // Reference data. Each file defaults to the file of that name in reference_dir, and reference_dir
  // defaults to the bundled files in assets/ (resolved in main.nf). A flag replaces that one file only.
  reference_dir = null   // a folder holding the four files below under these names
  ppi_network   = null   // default: <reference_dir>/STRING_physical_ENSG.csv
  druggability  = null   // default: <reference_dir>/druggability_scores_annot.csv
  ml_scores     = null   // default: <reference_dir>/ML_data.csv
  citations     = null   // default: <reference_dir>/PubTator3_counts.csv

  // HHNet controls
  cpus                   = 4
  hhnet_num_permutations = 100
  hhnet_network_name     = "STRING"
  hhnet_score_name       = "scores"   // recommended; optional
  hhnet_compile_fortran  = "auto"

  // Environments
  hhnet_conda_env  = "${projectDir}/envs/hhnet.yaml"
  r_conda_env      = "${projectDir}/envs/r.yaml"
  hhnet_dir        = null
  hhnet_intermediate_cache_dir = "${projectDir}/bin/hierarchical-hotnet/cache/hhnet_intermediates"
  
  // HHNet post-processing defaults
  hhnet_min_cluster_size = 2
  hhnet_n_clusters       = 0
  hhnet_seed             = 1234
  hhnet_node_id_type     = "ensembl_gene_id"
  hhnet_extra_colours    = ""
  hhnet_plot_max_nodes   = 5000

  // Ranking defaults
  ranking_network   = "neighbours"
  ranking_features  = "degree,betweenness,closeness,eigen_centrality,page_rank,drug_score"
  negative_features = ""
  ranking_step      = 0.1

  // Ranking inputs
  gene_map       = null
  id_annot_cache = null
  write_rds      = true

  // ---- update_data.nf: build new versions of the reference data (see "Updating the reference data" in the README)
  datasets         = null    // string, citations, druggability (comma-separated), or all
  data_outdir      = null    // default: reference_data/<YYYY-MM-DD> in the folder the run is started from
  data_cpus        = null    // default: all CPUs
  min_free_disk_gb = 80      // druggability only: stop before starting if less disk is free (0 skips the check)
                             // (reference_dir above, default assets/, supplies the files that are not rebuilt)
  // STRING
  string_version      = "12.5"   // release of the physical links file
  string_info_version = "12.0"   // release of the protein info and aliases files (STRING 12.5 reuses 12.0's)
  // citation counts
  gene2pubtator3   = null    // a kept copy of gene2pubtator3.gz to use instead of NCBI's current file
  // druggability: structures
  alphafold_version     = "latest"  // AlphaFold DB version to download, or a number such as 6
  alphafold_structures  = null      // a folder of AlphaFold structures to score instead of downloading
  swissmodel_structures = null      // a folder of SWISS-MODEL structures (<UniProt ID>.pdb) instead of downloading
  // druggability: scoring settings (the defaults built the bundled table)
  min_struct_conf_af    = 0     // whole-model filter, mean pLDDT 0-100 (0 scores every structure)
  min_struct_conf_sm    = 0     // whole-model filter, mean QMEANDisCo 0-1 (0 scores every structure)
  min_residues          = 80    // structures shorter than this are not scored
  min_conf              = 70    // pockets and windows count only where mean confidence is at least this
  pocketminer_window    = 10    // residues averaged on either side
  pocketminer_threshold = 0.7   // averaged score that counts as a cryptic pocket hit
  pack_working_files    = true  // pack the large working folders into archives at the end (data_scripts/druggability/pack_results.sh)
  // environments
  data_conda_env        = "${projectDir}/envs/data.yaml"
  pocketminer_conda_env = "${projectDir}/envs/pocketminer.yaml"
  pocketminer_python    = null  // a Python with PocketMiner's packages, instead of the pocketminer_conda_env
  data_scripts          = "${projectDir}/data_scripts"   // the scripts update_data.nf runs
}

process {
  // selected by label, so that main.nf and update_data.nf, which share this file, do not warn about each
  // other's processes
  withLabel: hhnet {
    cpus   = params.cpus
    time   = "24h"
    conda  = params.hhnet_conda_env
  }

  withLabel: hhnet_post {
    cpus   = params.cpus
    time   = "6h"
    conda = params.r_conda_env  
  }

  withLabel: ranking {
    cpus   = params.cpus
    time   = "6h"
    conda = params.r_conda_env
  }

  // update_data.nf
  withLabel: data {
    conda = params.data_conda_env
  }
  withLabel: data_heavy {
    cpus  = { params.data_cpus ?: Runtime.runtime.availableProcessors() }
    conda = params.data_conda_env
  }
  withLabel: pocketminer_env {
    conda = { params.pocketminer_python ? null : params.pocketminer_conda_env }
  }
  withLabel: ensembl {
    // Ensembl 116 BioMart is sometimes unreachable for an hour or more: wait 10, 20, then 40 minutes and retry
    errorStrategy = { task.attempt <= 3 ? 'retry' : 'terminate' }
    maxRetries    = 3
    beforeScript  = { task.attempt > 1 ? "sleep ${600 * Math.pow(2, task.attempt - 2) as int}" : '' }
  }
}

profiles {
  // NOTE: must run `-profile conda` for conda to actually be used
  conda {
    conda.enabled = true
  }

  docker {
    docker.enabled = true
  }

  apptainer {
    apptainer.enabled   = true
    apptainer.autoMounts = true
  }
}